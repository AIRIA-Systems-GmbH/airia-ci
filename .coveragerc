#
# Python half of the coverage gate (tests/coverage.sh). The shipped scripts,
# and the Python heredocs tests/steps.py extracts from the YAML.
[run]
branch = true
parallel = true
patch = subprocess
data_file = build/coverage/.coverage
source =
    .github
    build/coverage/src
